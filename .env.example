# Copy to .env and fill in - see README.md for where these come from
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in the Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the browser lands after signing in.
# Leave empty in production (the API serves the built Vue app itself).
# For `npm run dev` in frontend/, set: http://localhost:5173
CLIENT_URL=

# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Absolute address of this API, used to build the links inside verification emails.
# Leave empty to derive it from the incoming request (fine unless you are behind a proxy).
PUBLIC_URL=

# SMTP for the verification emails. Leave SMTP_HOST empty during development and
# the link gets printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EatHub <no-reply@eathub.local>

PORT=4000
